---
import { Icon } from 'astro-icon/components'
---

<button id="scrollToTopBtn" 
  class="fixed bottom-5 right-5 px-4 py-4 z-100 text-white rounded-full shadow-lg bg-linear-to-r from-green-400 to-blue-500 hover:from-green-500 hover:to-blue-600 focus:outline-none" 
  title="Go to top">
  <Icon name="line-md:arrow-up-circle" class="text-white text-2xl"/>
  </button>

  	<script is:inline>
	  // Get the button
	  const mybutton = document.getElementById("scrollToTopBtn");
	
	  // When the user scrolls down 20px from the top of the document, show the button
	  window.onscroll = function () {
		if (document.body.scrollTop > 20 || document.documentElement.scrollTop > 20) {
		  mybutton.style.display = "block";
		} else {
		  mybutton.style.display = "none";
		}
	  };
	
	  // When the user clicks on the button, scroll to the top of the document
	  mybutton.onclick = function () {
		document.body.scrollTop = 0;
		document.documentElement.scrollTop = 0;
	  };
	</script>