  <script is:inline>
function initContactFormValidation() {
  const form = document.getElementById('contactForm');
  if (!form) return;

  const submitBtn = document.getElementById('submitBtn');
  const spinner = submitBtn?.querySelector('.spinner-border');

  const nameInput = form.querySelector('[name="name"]');
  const emailInput = form.querySelector('[name="email"]');
  const mobileInput = form.querySelector('[name="mobile"]');
  const messageInput = form.querySelector('[name="message"]');

  const nameError = form.querySelector('.name-error');
  const emailError = form.querySelector('.email-error');
  const mobileError = form.querySelector('.mobile-error');
  const messageError = form.querySelector('.message-error');

  const emailPattern = /^[\w.-]+@([\w-]+\.)+[a-zA-Z]{2,}$/;

  function validateField(input, errorElement, validatorFn, errorMessage) {
    const value = input.value.trim();
    const isValid = validatorFn(value);
    errorElement.textContent = isValid ? '' : errorMessage;
    errorElement.style.display = isValid ? 'none' : 'block';
    return isValid;
  }

  function clearErrorOnInput(input, errorElement) {
    input.addEventListener('input', () => {
      if (input.value.trim() !== '') {
        errorElement.textContent = '';
        errorElement.style.display = 'none';
      }
    });
  }

  // Attach blur validation
  nameInput.addEventListener('blur', () =>
    validateField(nameInput, nameError, val => val.length >= 2, 'Name is required.')
  );
  emailInput.addEventListener('blur', () =>
    validateField(emailInput, emailError, val => emailPattern.test(val), 'Valid email is required.')
  );
  mobileInput.addEventListener('blur', () =>
    validateField(mobileInput, mobileError, val => /^\d{10}$/.test(val), 'Valid 10-digit mobile number is required.')
  );
  messageInput.addEventListener('blur', () =>
    validateField(messageInput, messageError, val => val.length > 0 && val.length <= 1000, 'Message must be 1-1000 characters.')
  );

  // Clear errors on typing
  clearErrorOnInput(nameInput, nameError);
  clearErrorOnInput(emailInput, emailError);
  clearErrorOnInput(mobileInput, mobileError);
  clearErrorOnInput(messageInput, messageError);
}

// Run on initial load
document.addEventListener('DOMContentLoaded', initContactFormValidation);
</script>