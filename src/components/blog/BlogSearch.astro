 <style>
    /* Hide the checkbox */
    #search-toggle {
      display: none;
    }

    /* Overlay styles */
    .search-overlay {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: #f6f4ff;
      z-index: 1050;
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .searchinput{
      position: absolute;
      top: 150px;
    }
    /* Show overlay when checkbox is checked */
    #search-toggle:checked ~ .search-overlay {
      opacity: 1;
      pointer-events: auto;
    }

    /* Search box styles */
    .search-box {
      width: 100%;
    }

    .close-search {
      position: absolute;
      top: 160px;
      right: 30px;
      color: rgb(32, 32, 32);
      font-size: 2rem;
      text-decoration: none;
      cursor: pointer;
    }

    .close-search:hover {
      color: #ccc;
    }
  </style>


<input type="checkbox" id="search-toggle">

  <!-- Search Button (acts as label for checkbox) -->
  <!-- <div class="text-center mt-5">
    <label for="search-toggle" class="btn btn-primary">
      Open Search
    </label>
  </div> -->

  <!-- Fullscreen Search Overlay -->
  <div class="search-overlay">
    <!-- Close button -->
    <label for="search-toggle" class="close-search">&times;</label>

    <div class="container mx-auto px-4">
      <div class="row justify-content-center">
        <div class="col-sm-6 searchinput">
          <input type="text" id="search-input" class="form-control form-control-lg" placeholder="Search..." autofocus>
            
          
          <div class="row" id="search-results">

          </div>
          
        </div>
        
      </div>

       
    </div>
    
  </div>

  
<style>
    .search-container {
        display: flex;
        align-items: center;
        margin-top: 1rem;
        flex-wrap: wrap; /* allow wrapping */
    }

    #search-input {
        border-radius: 5px;
        font-size: 1rem;
        height: 50px;
        border-radius: 30px;
        padding-left: 35px;
        border: none;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        flex: 1; /* allow input to expand */
        min-width: 200px;
    }

    #search-button {
        background: var(--primary-gradient);
        color: white;
        border: none;
        padding: 0.75rem 1rem;
        border-radius: 5px;
        margin-left: 0.5rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }

    #search-button:hover {
        transform: scale(1.05);
    }

    #search-results {
        margin-top: 1rem;
    }

    .search-result {
        padding: 1rem;
        border-bottom: 1px solid #eee;
    }

    .search-result:last-child {
        border-bottom: none;
    }

    .search-result h6 {
        margin: 0;
    }

    .search-result a {
        text-decoration: none;
        color: var(--primary-color);
    }

    /* Responsive Styles */
    @media (max-width: 600px) {
        .search-container {
            flex-direction: column;
            align-items: stretch;
        }

        .close-search {
         top: 160px !important;
        }

        #search-button {
            margin-left: 0;
            margin-top: 0.5rem;
            width: 100%;
        }
    }
</style>

<script define:vars={{ allPosts }}>
    const searchInput = document.getElementById('search-input');
    const searchResults = document.getElementById('search-results');

    const slugify = (text) => {
        return text
            .toString()
            .toLowerCase()
            .replace(/\s+/g, '-')
            .replace(/[^\w\-]+/g, '')
            .replace(/\-\-+/g, '-')
            .replace(/^-+/, '')
            .replace(/-+$/, '');
    };

    const dateFormat = (datetime) => {
        const dateTime = new Date(datetime);
        const date = dateTime.toLocaleDateString([], {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
        });
        return date;
    };

    const readingTime = (content) => {
        const WPS = 275 / 60;
        let images = 0;
        const regex = /\w/;
        let words = content.split(' ').filter((word) => {
            if (word.includes('<img')) {
                images += 1;
            }
            return regex.test(word);
        }).length;
        let imageAdjust = images * 4;
        let imageSecs = 0;
        let imageFactor = 12;
        while (images) {
            imageSecs += imageFactor;
            if (imageFactor > 3) {
                imageFactor -= 1;
            }
            images -= 1;
        }
        const minutes = Math.ceil(((words - imageAdjust) / WPS + imageSecs) / 60);
        if (minutes < 10) {
            if (minutes < 2) {
                return '0' + minutes + ' Min read';
            } else {
                return '0' + minutes + ' Mins read';
            }
        } else {
            return minutes + ' Mins read';
        }
    };

    function performSearch() {
        const searchTerm = searchInput.value.trim().toLowerCase();
        if (!searchTerm) {
            searchResults.innerHTML = '';
            return;
        }

        const filteredPosts = allPosts.filter(post => {
            const title = post.data.title ? post.data.title.toLowerCase() : '';
            const description = post.data.description ? post.data.description.toLowerCase() : '';
            const categories = post.data.categories ? post.data.categories.map(category => category.toLowerCase()) : [];
            const body = post.body ? post.body.toLowerCase() : '';
            return title.includes(searchTerm) || body.includes(searchTerm) || description.includes(searchTerm) || categories.some(category => category.includes(searchTerm));
        });

        if (filteredPosts.length > 0) {
            searchResults.innerHTML = filteredPosts.map(post => {
                const { title, image, date, categories } = post.data;
                return `
                    <div class="col-md-4 mb-4 fade-in">
                        <div class="blog-card">
                            <div class="blog-image">
                                ${image ? `
                                    <a href="/blog/${post.slug}">
                                        <img src="${image}" alt="${title}" />
                                    </a>
                                ` : ''}
                                <a href="/blog/${post.slug}">
                                    <div class="blog-overlay">
                                        <i class="fas fa-eye"></i>
                                    </div>
                                </a>
                            </div>
                            <div class="blog-content">
                                ${categories?.map((category) => `
                                    <a href="/blog/category/${slugify(category)}" class="blog-category-link">
                                        <span class="blog-category">${category}</span>
                                    </a>
                                `).join('') || ''}
                                <h3 class="blog-title">
                                    <a href="/blog/${post.slug}">${title}</a>
                                </h3>
                                <div class="blog-meta">
                                    <div class="blog-author">
                                        <div class="author-avatar bi bi-book"></div>
                                        <span>${readingTime(post.body)}</span>
                                    </div>
                                    <div class="blog-date">
                                        <i class="fas fa-calendar-alt"></i>
                                        <span>${dateFormat(date)}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        } else {
            searchResults.innerHTML = '<p>No results found.</p>';
        }
    }

    searchInput.addEventListener('input', performSearch);
</script>