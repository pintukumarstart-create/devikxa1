	<script is:inline>
		// Get the header element
		const header = document.getElementById('header');
	
		// Function to handle scroll event
		function handleScroll() {
			const currentScrollY = window.scrollY;
			
			// Get the menu items and SVG elements
			const menuLinks = document.querySelectorAll('.header .menu > ul > li > a');
			const menuIcons = document.querySelectorAll('.header .menu > ul > li > a > svg');
			const rightSvg = document.querySelectorAll('.item-right > a > svg');
			const span = document.querySelectorAll('.item-right > a > span');
	
			// If scrolled more than 50px, apply gradient background and text color change, else reset
			if (currentScrollY > 50) {
				// Add gradient and remove transparent background
				if (!header.classList.contains('bg-linear-to-r')) {
					header.classList.add('bg-linear-to-r', 'from-green-400', 'to-blue-400', 'text-gray-900', 'shadow-[-3px_5px_8px_5px_rgba(0,_0,_0,_0.35)]');
					header.classList.remove('bg-transparent');
				}
				// Reset text color to default
				menuLinks.forEach(link => link.style.color = '');
				menuIcons.forEach(icon => icon.style.color = '');
				rightSvg.forEach(rtsvg => rtsvg.style.color = '');
				span.forEach(spn => spn.style.color = '');
			} else {
				// Remove gradient and set transparent background
				if (header.classList.contains('bg-linear-to-r')) {
					header.classList.remove('bg-linear-to-r', 'from-green-400', 'to-blue-400', 'text-gray-900', 'shadow-[-3px_5px_8px_5px_rgba(0,_0,_0,_0.35)]');
					header.classList.add('bg-transparent');
				}
				// Change text color to white when background is transparent
				menuLinks.forEach(link => link.style.color = '#e1e1e1');
				menuIcons.forEach(icon => icon.style.color = '#e1e1e1');
				rightSvg.forEach(rtsvg => rtsvg.style.color = '#e1e1e1');
				span.forEach(spn => spn.style.color = '#e1e1e1');
			}
		}
	
		// Throttle scroll events for better performance using requestAnimationFrame
		window.addEventListener('scroll', () => {
			requestAnimationFrame(handleScroll);
		});
	
		// Initial check on page load (in case the page starts at the top)
		handleScroll();
	</script>
	
	

	<script is:inline>
	

		const menu = document.querySelector(".menu");
	 const menuMain = menu.querySelector(".menu-main");
	 const goBack = menu.querySelector(".go-back");
	 const menuTrigger = document.querySelector(".mobile-menu-trigger");
	 const closeMenu = menu.querySelector(".mobile-menu-close");
	 let subMenu;
	 menuMain.addEventListener("click", (e) =>{
		 if(!menu.classList.contains("active")){
			 return;
		 }
	   if(e.target.closest(".menu-item-has-children")){
			const hasChildren = e.target.closest(".menu-item-has-children");
		  showSubMenu(hasChildren);
	   }
	 });
	 goBack.addEventListener("click",() =>{
		  hideSubMenu();
	 })
	 menuTrigger.addEventListener("click",() =>{
		  toggleMenu();
	 })
	 closeMenu.addEventListener("click",() =>{
		  toggleMenu();
	 })
	 document.querySelector(".menu-overlay").addEventListener("click",() =>{
		 toggleMenu();
	 })
	 function toggleMenu(){
		 menu.classList.toggle("active");
		 document.querySelector(".menu-overlay").classList.toggle("active");
	 }
	 function showSubMenu(hasChildren){
		subMenu = hasChildren.querySelector(".sub-menu");
		subMenu.classList.add("active");
		subMenu.style.animation = "slideLeft 0.5s ease forwards";
		const menuTitle = hasChildren.querySelector("i").parentNode.childNodes[0].textContent;
		menu.querySelector(".current-menu-title").innerHTML=menuTitle;
		menu.querySelector(".mobile-menu-head").classList.add("active");
	 }
	
	 function  hideSubMenu(){  
		subMenu.style.animation = "slideRight 0.5s ease forwards";
		setTimeout(() =>{
		   subMenu.classList.remove("active");	
		},300); 
		menu.querySelector(".current-menu-title").innerHTML="";
		menu.querySelector(".mobile-menu-head").classList.remove("active");
	 }
	 
	 window.onresize = function(){
		 if(this.innerWidth >991){
			 if(menu.classList.contains("active")){
				 toggleMenu();
			 }
	
		 }
	 }
	
	
	  </script>













  <style>
	/* Adding smooth transition for carousel sliding */
	.carousel input[type="radio"]:checked ~ .testimonials {
		transform: translateX(0);
		transition: transform 0.5s ease-in-out;
	}
  
	.carousel input[type="radio"]:checked:nth-child(2) ~ .testimonials {
		transform: translateX(-100%);
	}
  
	.carousel input[type="radio"]:checked:nth-child(3) ~ .testimonials {
		transform: translateX(-200%);
	}
  
	.carousel input[type="radio"]:checked:nth-child(4) ~ .testimonials {
		transform: translateX(-300%);
	}
  
	.carousel input[type="radio"]:checked:nth-child(5) ~ .testimonials {
		transform: translateX(-400%);
	}
  
	.bggrad{
	  background: linear-gradient(45deg, #04ff60, #0273ff);
	}
  </style>
  
  <script is:inline>
	function updateIndicators() {
		// Get all radio buttons
		const radios = document.querySelectorAll('input[name="carousel"]');
		const indicators = document.querySelectorAll('span[id^="indicator"]');
  
		radios.forEach((radio, index) => {
			if (radio.checked) {
				indicators[index].classList.remove('bg-gray-600');
				indicators[index].classList.add('bggrad');
			} else {
				indicators[index].classList.remove('bggrad');
				indicators[index].classList.add('bg-gray-600');
			}
		});
	}
  
	// Initialize the indicators on page load
	document.addEventListener('DOMContentLoaded', updateIndicators);
  
	// Auto-change carousel every 4 seconds
	let currentIndex = 6;
	const radios = document.querySelectorAll('input[name="carousel"]');
	setInterval(() => {
		currentIndex = (currentIndex + 1) % radios.length;
		radios[currentIndex].checked = true;
		updateIndicators();
	}, 1000);  // Change every 1 seconds
  </script>