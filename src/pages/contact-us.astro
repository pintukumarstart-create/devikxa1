<ScrollTop />
 <Footer />


 <script is:inline>
    // REPLACE WITH YOUR GOOGLE APPS SCRIPT URL
    const GOOGLE_SCRIPT_URL = 'https://script.google.com/macros/s/AKfycbxGuKeNC-KwW5n7J-UA_1kxwgLZKY_JRnJu7idNr2OpK_dhlqqwRZlBVS3-oB8uu-GlXw/exec';
    
    const form = document.getElementById('contactForm');
    const submitBtn = document.getElementById('submitBtn');
    const loading = document.getElementById('loading');
    const responseMessage = document.getElementById('responseMessage');
    
    // Validation functions
    const validators = {
    name: (value) => {
        if (!value || value.length < 2) return 'Name must be at least 2 characters';
        if (value.length > 100) return 'Name too long';
        if (!/^[a-zA-Z\s\-'\.]+$/.test(value)) return 'Name contains invalid characters';
        return null;
    },
    
    email: (value) => {
        if (!value) return 'Email is required';
        if (!/^\S+@\S+\.\S+$/.test(value)) return 'Invalid email format';
        return null;
    },
    
    mobile: (value) => {
        if (!value) return 'Mobile number is required';
        if (!/^[0-9+\-\s()]{10,15}$/.test(value)) return 'Invalid mobile number';
        return null;
    },
    
    message: (value) => {
        if (!value) return 'Message is required';
        if (value.length < 10) return 'Message must be at least 10 characters';
        return null;
    },
    
};
    
    form.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        // Hide previous messages
        responseMessage.className = 'message';
        responseMessage.style.display = 'none';
        
        // Honeypot check
        const honeypot = form.querySelector('input[name="website_url"]');
        if (honeypot.value) {
            showMessage('success', 'Message sent successfully!');
            form.reset();
            return;
        }
        
        // Get form data
        const formData = {
            name: form.name.value.trim(),
            email: form.email.value.trim(),
            mobile: form.mobile.value.trim(),
            website: form.website.value.trim() || 'Not provided',
            message: form.message.value.trim()
        };
        
        // Validate all fields
        for (const [field, value] of Object.entries(formData)) {
            if (validators[field]) {
                const error = validators[field](value);
                if (error) {
                    showMessage('error', error);
                    document.getElementById(field).focus();
                    return;
                }
            }
        }
        
        // Disable form and show loading
        submitBtn.disabled = true;
        loading.classList.add('show');
        
        try {
            // Create URL-encoded form data (THIS IS THE FIX)
            const urlEncodedData = new URLSearchParams();
            urlEncodedData.append('name', formData.name);
            urlEncodedData.append('email', formData.email);
            urlEncodedData.append('mobile', formData.mobile);
            urlEncodedData.append('website', formData.website);
            urlEncodedData.append('message', formData.message);
            
            // Send to Google Sheets using form-urlencoded
            const response = await fetch(GOOGLE_SCRIPT_URL, {
                method: 'POST',
                mode: 'no-cors',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded',
                },
                body: urlEncodedData.toString()
            });
            
            // With no-cors, we can't read response, assume success
            showMessage('success', 'Thank you! Your message has been sent successfully.');
            form.reset();
            
        } catch (error) {
            console.error('Error:', error);
            showMessage('error', 'Sorry, there was an error. Please try again.');
        } finally {
            submitBtn.disabled = false;
            loading.classList.remove('show');
        }
    });
    
    function showMessage(type, text) {
        responseMessage.className = `message ${type}`;
        responseMessage.textContent = text;
        responseMessage.style.display = 'block';
        
        if (type === 'success') {
            setTimeout(() => {
                responseMessage.style.display = 'none';
            }, 5000);
        }
    }
    
    // Real-time validation
    ['name', 'email', 'mobile', 'message', 'website'].forEach(field => {
        const element = document.getElementById(field);
        if (element) {
            element.addEventListener('blur', function() {
                const error = validators[field](this.value.trim());
                this.style.borderColor = error ? '#dc3545' : '#28a745';
            });
            
            element.addEventListener('input', function() {
                this.style.borderColor = '#ddd';
            });
        }
    });
    </script>
