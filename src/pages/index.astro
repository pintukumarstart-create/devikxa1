  <script is:inline>
	// Simple JavaScript for tab functionality
	const tabButtons = document.querySelectorAll('.tab-btn');
	const tabPanels = document.querySelectorAll('.tab-panel');

	tabButtons.forEach((button) => {
		button.addEventListener('click', () => {
			// Hide all tab content
			tabPanels.forEach((panel) => panel.classList.add('hidden'));

			// Remove active class from all buttons
			tabButtons.forEach((btn) => btn.classList.remove('bg-green-600', 'bg-blue-600', 'bg-teal-600'));

			// Show the selected tab content and add active class to the clicked button
			const targetContent = document.getElementById(button.id.replace('Tab', 'Content'));
			targetContent.classList.remove('hidden');

			button.classList.add('bg-green-600', 'bg-blue-600', 'bg-teal-600');
		});
	});

	// Show SEO tab by default
	document.getElementById('seoContent').classList.remove('hidden');
</script>



