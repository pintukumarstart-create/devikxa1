      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
            Our Comprehensive
            <span class="bg-linear-to-r from-blue-600 to-green-500 bg-clip-text text-transparent"> Digital Services</span>
          </h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            End-to-end digital marketing solutions tailored to your business goals and industry requirements
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {servicePages.map((service, index) => {
            const delay = (index % 3) * 100;
            return (
              <a 
                href={`/services/${service.slug}/`} 
                class="group block"
                data-aos="fade-up"
                data-aos-delay={delay}
                data-aos-duration="900"
              >
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden border border-gray-200 hover:border-blue-300 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl h-full">
                  {/* Service Header */}
