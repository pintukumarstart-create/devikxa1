---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { Icon } from 'astro-icon/components';
import Footer from '../../components/Footer.astro';
import ScrollTop from '../../components/ScrollTop.astro';

const servicePages = await getCollection('servicepage');
---

<Layout title="Digital Marketing Services | DevikXa" description="Comprehensive digital marketing services in India - SEO, PPC, Social Media Marketing, Content Marketing & more">
  <main class="pt-20 ">



     <!-- Hero Section -->
    <section class="relative overflow-hidden pt-24 pb-16 md:pt-32 md:pb-24 bg-linear-to-br from-blue-50 via-white to-green-50">
      <!-- Background decorative elements -->
      <div class="absolute top-0 right-0 w-1/3 h-1/3 bg-linear-to-bl from-blue-100 to-transparent rounded-full -translate-y-1/2 translate-x-1/2 blur-3xl opacity-50"></div>
      <div class="absolute bottom-0 left-0 w-1/3 h-1/3 bg-linear-to-tr from-green-100 to-transparent rounded-full translate-y-1/2 -translate-x-1/2 blur-3xl opacity-50"></div>
      
      <div class="container mx-auto px-4 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <span class="inline-flex items-center px-4 py-2 rounded-full bg-linear-to-r from-blue-100 to-green-100 text-blue-600 font-semibold text-sm mb-6" data-aos-duration="900" data-aos="zoom-in-up">
            <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
