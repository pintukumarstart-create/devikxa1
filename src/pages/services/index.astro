                    {/* Tags */}
                    <div class="flex flex-wrap gap-2">
                      {service.data.services?.slice(0, 3).map((s, i) => (
                        <span class={`px-3 py-1 rounded-full text-xs font-medium ${i === 0 ? 'bg-blue-100 text-blue-700' : i === 1 ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'}`}>
                          {s.title}
                        </span>
                      ))}
                    </div>
                  </div>

                  {/* Footer */}
                </div>
              </a>
            );
