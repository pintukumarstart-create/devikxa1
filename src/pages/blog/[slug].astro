                           <div class="toc-container">
                            <div class="toc-title">
                                <i class="fas fa-list"></i> Table of Contents
                            </div>
                            <ul class="toc-list" id="toc">
                                {h2Headings.map((heading, index) => (
                                    <li key={index} class="toc-item">
                                        <a href={`#${heading.slug}`} class="toc-link">{`${index + 1}. ${heading.text}`}</a>
