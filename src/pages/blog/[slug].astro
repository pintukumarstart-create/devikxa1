---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import dateFormat  from "../../lib/utils/dateFormat";
import readingTime  from "../../lib/utils/readingTime";
import Footer from '../../components/Footer.astro';
import RecentBlog from '../../components/blog/RecentBlog.astro'
import Category from '../../components/blog/Category.astro'
import { Icon } from "astro-icon/components";



export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const filteredPosts = posts.filter(post => post.slug !== "-index");
  return filteredPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();
const { title, date, image, authors, authors_discription, author_img, categories, views, description, meta_title} = post.data;


const h2Headings = headings ? headings.filter(heading => heading.depth === 2) : [];

---

<Layout title={meta_title || title} description={description}>

       <!-- Reading Progress Bar -->
    <div class="progress-bar-container">
        <div class="progress-bar" id="reading-progress"></div>
    </div>

    <section class="text-center py-30 px-4 md:px-16 bg-linear-to-r from-green-400 to-blue-400 text-gray-900">
      <h1 class="text-4xl md:text-5xl font-extrabold leading-tight mb-6">
       {title}
      </h1>

      <div class="flex justify-center space-x-4">
        <div class="blog-meta">
                            <div class="meta-item">
                                  <Icon name="mdi:calendar" class="text-3xl"/>
                                <span>{dateFormat(date)}</span>
                            </div>
                            <div class="meta-item">
                               <Icon name="mdi:clock" class="text-3xl"/>
                                <span>{readingTime(post.body)}</span>
                            </div>
                            <div class="meta-item">
                               <Icon name="mdi:eye" class="text-3xl"/>
                                <span>{views}</span>
                            </div>
                        </div>
      </div>
    </section>











<script type="module">

import { gsap } from "https://cdn.skypack.dev/gsap";
  import { ScrollToPlugin } from "https://cdn.skypack.dev/gsap/ScrollToPlugin";

  gsap.registerPlugin(ScrollToPlugin);

  document.addEventListener("DOMContentLoaded", function () {
    const tocLinks = document.querySelectorAll(".toc-link");

    tocLinks.forEach(link => {
      link.addEventListener("click", function (e) {
        e.preventDefault();

        const targetId = this.getAttribute("href");
        const targetElement = document.querySelector(targetId);

        if (targetElement) {
          gsap.to(window, {
            duration: 1,
            scrollTo: { y: targetElement, offsetY: 95 },
            ease: "power2.out"
          });
        }
      });
    });
  });
</script>





